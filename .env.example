# ---------------------------------------------------------------------------
# Willary STEM — environment
# Copy to .env.local for Next.js runtime + .env for Prisma CLI, or just .env
# ---------------------------------------------------------------------------

# Neon Postgres.
# DATABASE_URL          = POOLED connection (host has "-pooler")
# DATABASE_URL_UNPOOLED = DIRECT connection (no "-pooler") — used for migrations.
#   The Neon–Vercel integration injects BOTH automatically in production.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Session signing secret — generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# First admin, created by `npm run db:seed`
SEED_ADMIN_EMAIL="you@willarystem.co.ke"
SEED_ADMIN_PASSWORD="change-me-min-10-chars"
SEED_ADMIN_NAME="William Otwola"

# --- Optional ---
# Lead-notification email (falls back to no-op if unset)
RESEND_API_KEY=""
NOTIFY_EMAIL_TO="you@willarystem.co.ke"
EMAIL_FROM="Willary STEM <hello@willarystem.co.ke>"

# One-time protected seeding of a remote DB via /api/seed?secret=...
SEED_SECRET=""

# Vercel Blob store — REQUIRED for admin media uploads in production
# (the serverless filesystem is read-only). Create at Vercel → Storage → Blob.
BLOB_READ_WRITE_TOKEN=""

# --- M-Pesa (Safaricom Daraja) — STK Push for BuildFest tickets ---
# Create an app at https://developer.safaricom.co.ke and use the Lipa na M-Pesa
# Online (STK Push) product. Sandbox works with test credentials.
MPESA_ENV="sandbox"                 # "sandbox" | "production"
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=""                  # your Paybill or Till (BusinessShortCode)
MPESA_PASSKEY=""                    # Lipa na M-Pesa Online passkey
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"  # or CustomerBuyGoodsOnline for a Till
MPESA_PARTYB=""                     # usually same as MPESA_SHORTCODE; leave blank to reuse it
# Must be a PUBLIC https URL Safaricom can reach. For local dev use a tunnel
# (ngrok / cloudflared) pointing at http://localhost:3000
MPESA_CALLBACK_URL="https://your-domain.example/api/mpesa/callback?token=REPLACE_ME"
MPESA_CALLBACK_SECRET="REPLACE_ME"  # must equal the ?token= value in the callback URL
# Local testing only: skip the real prompt and mark payments PAID instantly.
MPESA_DEV_BYPASS="false"
